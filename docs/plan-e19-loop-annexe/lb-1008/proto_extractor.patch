+    // PROTOTYPE (scratch only, O-E19-66): FONT3.TIM's 4 bpp image decoded with one 16-colour entry of WIND.CL, as the
+    // binary draws it (0x80044B7C-0x80044B8C fills the CLUT table from wind.cl; the text bands use entry 8). Same
+    // BGR555 bit replication as TimLoader. Colour 0x0000 is transparent and keeps FONT3.TIM's own index 0 RGB.
+    public static Bitmap DecodeFontTimWithWindClut(string folderName, int windClutEntry)
+    {
+        using var fs = File.OpenRead(Path.Combine(folderName, "FONT3.TIM"));
+        using var br = new BinaryReader(fs);
+        var raw = TimLoader.LoadTimRaw(br, Color.FromArgb(255, 156, 165, 132));
+        var wind = File.ReadAllBytes(Path.Combine(folderName, "WIND.CL"));
+        var pal = new Color[16];
+        for (var i = 0; i < 16; i++)
+        {
+            int c = BitConverter.ToUInt16(wind, (windClutEntry * 16 + i) * 2);
+            if (c == 0)
+            {
+                pal[i] = raw.Palettes![0][0];
+                continue;
+            }
+
+            int r = ((c & 0x1F) << 3) | ((c & 0x1F) >> 2);
+            int g = (((c >> 5) & 31) << 3) | (((c >> 5) & 31) >> 2);
+            int b = (((c >> 10) & 31) << 3) | (((c >> 10) & 31) >> 2);
+            pal[i] = Color.FromArgb(255, r, g, b);
+        }
+
+        return TimLoader.DecodeBuffer(0, raw.Width, raw.Height, raw.Bpp, new[] { pal }, raw.ImgWWords, raw.ImgData);
+    }
