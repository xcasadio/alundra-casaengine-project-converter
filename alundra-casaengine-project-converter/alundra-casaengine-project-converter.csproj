<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>alundra_casaengine_project_converter</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Drawing.Common (Bitmap/Image) for baking backdrop layer PNGs. Referenced directly
         (rather than via UseWindowsForms, which the analyser's AlundraEngine project uses) because
         UseWindowsForms's implicit "using System.Drawing" collides with Microsoft.Xna.Framework's
         own Rectangle/Point already used elsewhere in this project. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="maps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Linked, not copied: the analyser owns this table and the game engine reads the same file,
         so a second copy here would drift the moment either side edits it. -->
    <None Include="..\alundra-datas-analyser\AlundraTools\AlundraTools\EntityNames.csv" Link="EntityNames.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e11c-musique.md, slice C1, D-C-2: same "linked, not copied" precedent as
         EntityNames.csv above - the analyser owns g_defaultSoundOffsetList (StaticVariables.cs),
         this converter only reads it. -->
    <None Include="..\alundra-datas-analyser\AlundraTools\AlundraTools\MapMusicIndex.csv" Link="MapMusicIndex.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e12-dialogues.md, slice E12.b, D-E12-2: same "linked, not copied" precedent as
         MapMusicIndex.csv above - the analyser owns g_fontCharWidthTable (StaticVariables.cs:9484),
         this converter only reads it. -->
    <None Include="..\alundra-datas-analyser\AlundraTools\AlundraTools\FontCharWidths.csv" Link="FontCharWidths.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e12-dialogues.md, slice E12.b, D-E12-6: unlike the tables above, this one is not in
         the decompiled code at all - it is the first 1024 int16 of the game's own ETC_RES.R file, so
         the analyser dumped it once straight off that file (see EtcIndexTable.csv's own header
         comment in AlundraTools.csproj). This converter only reads it. -->
    <None Include="..\alundra-datas-analyser\AlundraTools\AlundraTools\EtcIndexTable.csv" Link="EtcIndexTable.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CasaEngineMonogame\CasaEngine\CasaEngine.csproj" />
    <ProjectReference Include="..\CasaEngineMonogame\CasaEngine.EditorServices\CasaEngine.EditorServices.csproj" />
    <ProjectReference Include="..\CasaEngineMonogame\MGUI\MGUI.Core\MGUI.Core.csproj" />
    <ProjectReference Include="..\CasaEngineMonogame\MGUI\MGUI.FontStashSharp\MGUI.FontStashSharp.csproj" />
    <ProjectReference Include="..\CasaEngineMonogame\MGUI\MGUI.Rendering.Abstractions\MGUI.Rendering.Abstractions.csproj" />
    <ProjectReference Include="..\CasaEngineMonogame\MGUI\MGUI.Shared\MGUI.Shared.csproj" />
  </ItemGroup>

</Project>
