<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CasaEngineMonogame\CasaEngine\CasaEngine.csproj" />
  </ItemGroup>

  <!-- The engine loads the gameplay DLL from the project root (see ProjectWriter.GameplayDllName
       and ProjectSettingsHelper.Load), so drop the built assembly there after every build. -->
  <Target Name="CopyGameplayDllToProject" AfterTargets="Build">
    <ItemGroup>
      <GameplayDeployFiles Include="$(TargetDir)Alundra.dll;$(TargetDir)Alundra.pdb" Condition="Exists('$(TargetDir)Alundra.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\alundra-project" Condition="'@(GameplayDeployFiles)' != ''" />
    <Copy SourceFiles="@(GameplayDeployFiles)" DestinationFolder="$(MSBuildProjectDirectory)\..\alundra-project" Condition="'@(GameplayDeployFiles)' != ''" SkipUnchangedFiles="true" />
  </Target>
</Project>